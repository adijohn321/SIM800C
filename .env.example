# Serial port for the SIM800C.
#   auto      -> detect the port the modem is plugged into (USB signature + AT probe)
#   COM3      -> force a specific port on Windows
#   /dev/ttyUSB0 -> force a specific port on Linux
SIM800C_PORT=auto
SIM800C_BAUDRATE=115200
SIM800C_TIMEOUT=5

# Set to true to run without hardware (simulated modem)
SIM800C_MOCK=false

# Reconnect automatically when the modem drops (runs from the inbox poller)
SIM800C_AUTO_RECONNECT=true

# Web server
HOST=0.0.0.0
PORT=8000

# Optional API key for REST access (leave empty to disable auth)
API_KEY=

# Inbox poll interval in seconds (0 disables auto-sync)
SIM800C_POLL_SECONDS=15
